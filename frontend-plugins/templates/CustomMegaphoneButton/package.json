{
  "name": "custom-megaphone-button",
  "version": "0.0.0",
  "description": "A template for creating custom MegaphoneButton for metatell",
  "type": "module",
  "scripts": {
    "dev": "pnpm set-uuid && env-cmd -f .uuid.env vp dev",
    "build": "rimraf dist && pnpm set-uuid && env-cmd -f .uuid.env vp build && env-cmd -f .uuid.env node ./scripts/add_metadata.js && node ./scripts/archive_dist.js",
    "preview": "vp preview",
    "test": "vp test run",
    "lint": "vp check",
    "lint-fix": "vp check --fix",
    "set-uuid": "node ./scripts/set_uuid.js > .uuid.env"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-toastify": "^9.1.3",
    "react-tooltip": "^6.0.8"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.20.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/react-modal": "^3.16.3",
    "@vitejs/plugin-react": "^6.0.5",
    "adm-zip": "^0.6.0",
    "env-cmd": "^11.0.0",
    "jsdom": "^30.0.1",
    "rimraf": "^6.1.3",
    "sass": "^1.102.0",
    "uuid": "^14.0.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
