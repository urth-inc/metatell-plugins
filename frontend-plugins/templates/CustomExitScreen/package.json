{
  "name": "custom-exit-screen-template",
  "description": "A template for creating a custom exit screen for metatell",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run set-uuid && env-cmd -f .uuid.env vite",
    "build": "rimraf dist && npm run set-uuid && env-cmd -f .uuid.env vite build && env-cmd -f .uuid.env node ./scripts/add_metadata.js && node ./scripts/archive_dist.js",
    "preview": "vite preview",
    "lint:tsc": "tsc --noEmit",
    "lint:biome": "biome check src",
    "lint": "npm run lint:tsc && npm run lint:biome",
    "lint-fix": "biome check --write src",
    "set-uuid": "node ./scripts/set_uuid.js > .uuid.env"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@module-federation/vite": "^1.20.5",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "adm-zip": "^0.6.0",
    "env-cmd": "^11.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "uuid": "^14.0.1",
    "vite": "^8.2.1"
  },
  "volta": {
    "node": "24.11.0",
    "npm": "11.6.2"
  }
}
