{
  "name": "custom-exit-screen-template",
  "version": "0.1.0",
  "description": "A template for creating a custom exit screen for metatell",
  "type": "module",
  "scripts": {
    "dev": "pnpm set-uuid && env-cmd -f .uuid.env vp dev",
    "build": "rimraf dist && pnpm set-uuid && env-cmd -f .uuid.env vp build && env-cmd -f .uuid.env node ./scripts/add_metadata.js && node ./scripts/archive_dist.js",
    "preview": "vp preview",
    "test": "vp test run",
    "lint": "vp check",
    "lint-fix": "vp check --fix",
    "set-uuid": "node ./scripts/set_uuid.js > .uuid.env"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "adm-zip": "^0.6.0",
    "env-cmd": "^11.0.0",
    "rimraf": "^6.1.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
