# Required. Expected JWT audience.
# Use the same client ID as the plugin METATELL_CLIENT_ID.
METATELL_CLIENT_ID=your-client-id

# Required. Issuer URL for the metatell organization realm.
# This must match the token iss claim exactly.
# Do not include /protocol/openid-connect/certs here.
# The backend appends that path only when fetching JWKS.
METATELL_ISSUER=https://your-issuer.example.com/realms/your-organization-id

# Optional. Allowed browser origins for CORS.
# Use * for local sample testing, or comma-separated origins for deployed backends.
METATELL_CORS_ORIGINS=*

# Optional. Backend HTTP port.
# Defaults to 3000 when omitted.
PORT=3000
